# ================================
# ScratchV3 Environment Configuration
# ================================

# Application Settings
# --------------------
# Secret key for session management and encryption (generate a strong random key)
SECRET_KEY=your-secret-key-here-change-this-in-production

# Environment mode: development, staging, production
ENVIRONMENT=development

# Enable/disable debug mode (set to false in production)
DEBUG=true

# Application host and port
HOST=0.0.0.0
PORT=8000

# Database Configuration
# ----------------------
# SQLite for development (default)
DATABASE_URL=sqlite:///./data/app.db

# PostgreSQL for production (recommended)
# DATABASE_URL=postgresql://username:password@localhost:5432/scratchv3

# Redis Configuration
# -------------------
# Redis URL for task queue and caching
REDIS_URL=redis://localhost:6379/0

# AI Service API Keys
# -------------------
# OpenAI API Key (primary AI provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenRouter API Key (alternative AI provider)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Image Generation Services
# -------------------------
# Pexels API Key for stock images (optional)
PEXELS_API_KEY=your-pexels-api-key-here

# Security & Encryption
# ---------------------
# 32-byte encryption key for sensitive data (API keys, passwords)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Session configuration
SESSION_EXPIRE_HOURS=24
SESSION_SECURE=false  # Set to true in production with HTTPS

# Task Scheduling Configuration
# -----------------------------
# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=5

# Task timeout in seconds
TASK_TIMEOUT=300

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=60

# Content Generation Settings
# ---------------------------
# Default AI model for content generation
DEFAULT_AI_MODEL=gpt-4

# Maximum tokens for AI responses
MAX_RESPONSE_TOKENS=2000

# Content quality settings
ENABLE_QA_FILTER=true
MIN_WORD_COUNT=100
MAX_WORD_COUNT=3000

# WordPress Integration
# ---------------------
# Default WordPress timeout (seconds)
WP_TIMEOUT=30

# WordPress API version
WP_API_VERSION=wp/v2

# Logging Configuration
# ---------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty to log to console only)
LOG_FILE=

# Enable request logging
LOG_REQUESTS=false

# File Upload Settings
# --------------------
# Maximum file size for uploads (in bytes)
MAX_UPLOAD_SIZE=10485760  # 10MB

# Allowed file extensions for chat references
ALLOWED_EXTENSIONS=txt,md,json

# Upload directory
UPLOAD_DIR=./uploads

# Data directory
DATA_DIR=./data

# Rate Limiting
# -------------
# Requests per minute per user
RATE_LIMIT_PER_MINUTE=100

# Requests per hour per user
RATE_LIMIT_PER_HOUR=1000

# Burst limit (requests per 10 seconds)
RATE_LIMIT_BURST=20

# Development Settings
# --------------------
# Enable auto-reload in development
AUTO_RELOAD=true

# Enable CORS for development
ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Production Settings
# -------------------
# Enable HTTPS redirect in production
FORCE_HTTPS=false

# Trusted proxy headers
TRUST_PROXY_HEADERS=false

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# Health Check Configuration
# --------------------------
# Health check endpoint timeout
HEALTH_CHECK_TIMEOUT=5

# Enable detailed health checks
DETAILED_HEALTH_CHECKS=true

# External Dependencies
# ---------------------
# External API timeouts
EXTERNAL_API_TIMEOUT=30

# Retry configuration for external APIs
EXTERNAL_API_RETRIES=3

# User Agent for external requests
USER_AGENT=ScratchV3/1.0

# Feature Flags
# -------------
# Enable WordPress integration
ENABLE_WORDPRESS=true

# Enable chat reference system
ENABLE_CHAT_REFERENCES=true

# Enable advanced AI features
ENABLE_ADVANCED_AI=true

# Timezone Configuration
# ----------------------
# Application timezone
TIMEZONE=UTC

# Date format for logs and UI
DATE_FORMAT=%Y-%m-%d %H:%M:%S

# ================================
# Environment-Specific Examples
# ================================

# Development Environment
# -----------------------
# DEBUG=true
# LOG_LEVEL=DEBUG
# ENABLE_CORS=true
# AUTO_RELOAD=true

# Production Environment
# ----------------------
# DEBUG=false
# LOG_LEVEL=WARNING
# FORCE_HTTPS=true
# SESSION_SECURE=true
# ENABLE_SECURITY_HEADERS=true
