# Production Environment Configuration Template
# Copy this to .env and fill in your actual values

# ===== SECURITY SETTINGS =====
# Generate these with: python generate_secrets.py
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_ENCRYPTION_KEY

# ===== SERVER CONFIGURATION =====
HOST=0.0.0.0
PORT=8081
ENVIRONMENT=production
DEBUG=False

# ===== SSL CONFIGURATION =====
USE_SSL=true
SSL_CERTFILE=ssl/cert.pem
SSL_KEYFILE=ssl/key.pem

# ===== RATE LIMITING =====
MAX_REQUESTS_PER_HOUR=100
MAX_REQUESTS_PER_DAY=1000

# ===== REDIS CONFIGURATION =====
# Use password-protected Redis in production
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# ===== API KEYS (Optional - can be set via UI) =====
# OPENAI_API_KEY=sk-your-openai-key
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# PEXELS_API_KEY=your-pexels-key

# ===== SMTP CONFIGURATION (Optional) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=your-email@gmail.com

# ===== AI SETTINGS =====
DEFAULT_AI_PROVIDER=openrouter
DEFAULT_OPENAI_MODEL=gpt-4
DEFAULT_OPENROUTER_MODEL=openrouter/auto

# ===== SECURITY HEADERS =====
ENABLE_SECURITY_HEADERS=true
FORCE_HTTPS=true

# ===== LOGGING =====
LOG_LEVEL=WARNING
LOG_REQUESTS=false

# ===== FILE UPLOAD SECURITY =====
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=txt,md,json
UPLOAD_DIR=./uploads

# ===== SESSION SECURITY =====
SESSION_EXPIRE_HOURS=24
SESSION_SECURE=true
